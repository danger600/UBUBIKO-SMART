PORT=5000
FRONTEND_URL=http://localhost:5173

# Use the exact hostname and port shown in your Aiven service connection details.
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=22143
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=ububiko_smart

# Generate a private random secret. Never commit your real .env file.
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

# For Aiven, keep SSL enabled. Put the downloaded CA certificate at backend/ca.pem,
# or set DB_SSL_CA_PATH to its location. Alternatively set DB_SSL_CA to the PEM text.
DB_SSL=true
DB_SSL_CA_PATH=./ca.pem
DB_SSL_CA=
